{
  "spec": {
    "title": "Quantum-Resistant Cryptosuites v1.0",
    "url": "https://w3c.github.io/vc-di-quantum-resistant/"
  },
  "algorithms": [
    {
      "html": "This algorithm is used to configure a cryptographic suite to be used by the\n<a data-cite=\"vc-data-integrity#add-proof\" href=\"https://www.w3.org/TR/vc-data-integrity/#add-proof\">Add Proof</a> and\n<a data-cite=\"vc-data-integrity#verify-proof\" href=\"https://www.w3.org/TR/vc-data-integrity/#verify-proof\">Verify Proof</a>\nfunctions in <cite><a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/\">Verifiable Credential Data Integrity 1.1</a></cite>. The algorithm takes an options object\n(<a data-link-type=\"dfn\" data-cite=\"infra\" data-cite-path=\"\" data-cite-frag=\"ordered-map\" href=\"https://infra.spec.whatwg.org/#ordered-map\">map</a> <var>options</var>) as input and returns a <a data-link-type=\"dfn\" data-lt=\"data integrity cryptographic suite instance\" data-cite=\"vc-data-integrity-1.1\" data-cite-path=\"\" data-cite-frag=\"dfn-data-integrity-cryptographic-suite-instance\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#dfn-data-integrity-cryptographic-suite-instance\">cryptosuite instance</a> (<a data-link-type=\"dfn\" data-cite=\"infra\" data-cite-path=\"\" data-cite-frag=\"struct\" href=\"https://infra.spec.whatwg.org/#struct\">struct</a> <var>cryptosuite</var>).",
      "rationale": ".algorithm",
      "steps": [
        {
          "html": "Initialize <var>cryptosuite</var> to an empty <a data-link-type=\"dfn\" data-cite=\"infra\" data-cite-path=\"\" data-cite-frag=\"struct\" href=\"https://infra.spec.whatwg.org/#struct\">struct</a>."
        },
        {
          "html": "If <var>options</var>.<var>type</var> does not equal <code>DataIntegrityProof</code>, return <var>cryptosuite</var>."
        },
        {
          "html": "If <var>options</var>.<var>cryptosuite</var> is listed in <a href=\"https://w3c.github.io/vc-di-quantum-resistant/#CryptosuiteTable\" data-matched-text=\"[[[#CryptosuiteTable]]]\" class=\"table-ref\" title=\"Full Disclosure Cryptosuites.\">Table <bdi class=\"\">3</bdi></a> then:",
          "rationale": ".algorithm",
          "steps": [
            {
              "html": "Set the values of the parameters <code>canonScheme</code>, <code>hashName</code>, <code>sigFunc</code>, and\n<code>verifyFunc</code>, as indicated in the section corresponding to the \"Details\" \ncolumn in the <a href=\"https://w3c.github.io/vc-di-quantum-resistant/#CryptosuiteTable\" data-matched-text=\"[[[#CryptosuiteTable]]]\" class=\"table-ref\" title=\"Full Disclosure Cryptosuites.\">Table <bdi class=\"\">3</bdi></a> with  <code>proofEncoding</code> set to <code>base64</code>."
            },
            {
              "html": "Set <var>cryptosuite</var>.<var>createProof</var> to the algorithm in Section\n<a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-cite-frag=\"create-proof\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1#create-proof]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#create-proof\" class=\"sec-ref\">§&nbsp;<bdi class=\"secno\">4.2.2 </bdi>Create Proof</a> passing in the above parameters."
            },
            {
              "html": "Set <var>cryptosuite</var>.<var>verifyProof</var> to the algorithm in Section\n<a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-cite-frag=\"verify-proof-0\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1#verify-proof-0]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#verify-proof-0\" class=\"sec-ref\">§&nbsp;<bdi class=\"secno\">4.2.3 </bdi>Verify Proof</a> passing in the above parameters."
            }
          ]
        },
        {
          "html": "If <var>options</var>.<var>cryptosuite</var> is listed in <a href=\"https://w3c.github.io/vc-di-quantum-resistant/#SDCryptosuiteTable\" data-matched-text=\"[[[#SDCryptosuiteTable]]]\" class=\"table-ref\" title=\"Selective Disclosure Cryptosuites.\">Table <bdi class=\"\">13</bdi></a> then:",
          "rationale": ".algorithm",
          "steps": [
            {
              "html": "Set the values of the parameters <code>approach</code>, <code>hashName</code>, <code>sigFunc</code>, and\n<code>verifyFunc</code>, as indicated in the corresponding\ncolumn in the <a href=\"https://w3c.github.io/vc-di-quantum-resistant/#SDCryptosuiteTable\" data-matched-text=\"[[[#SDCryptosuiteTable]]]\" class=\"table-ref\" title=\"Selective Disclosure Cryptosuites.\">Table <bdi class=\"\">13</bdi></a>."
            },
            {
              "html": "Set <var>cryptosuite</var>.<var>createBaseProof</var> to the algorithm in Section\n<a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-cite-frag=\"create-base-proof\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1#create-base-proof]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#create-base-proof\" class=\"sec-ref\">§&nbsp;<bdi class=\"secno\">4.3.2 </bdi>Create Base Proof</a> passing in the above parameters."
            },
            {
              "html": "Set <var>cryptosuite</var>.<var>addDerivedProof</var> to the algorithm in Section\n<a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-cite-frag=\"add-derived-proof\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1#add-derived-proof]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#add-derived-proof\" class=\"sec-ref\">§&nbsp;<bdi class=\"secno\">4.3.3 </bdi>Add Derived Proof</a> passing in the above parameters."
            },
            {
              "html": "Set <var>cryptosuite</var>.<var>verifyDerivedProof</var> to the algorithm in Section\n<a data-cite=\"VC-DATA-INTEGRITY-1.1\" data-cite-frag=\"verify-derived-proof\" data-matched-text=\"[[[VC-DATA-INTEGRITY-1.1#verify-derived-proof]]]\" href=\"https://www.w3.org/TR/vc-data-integrity-1.1/#verify-derived-proof\" class=\"sec-ref\">§&nbsp;<bdi class=\"secno\">4.3.4 </bdi>Verify Derived Proof</a> passing in the above parameters."
            }
          ]
        },
        {
          "html": "Return <var>cryptosuite</var>."
        }
      ]
    }
  ]
}