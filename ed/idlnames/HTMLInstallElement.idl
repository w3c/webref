// Source: Web Install (https://wicg.github.io/install-element/)
[Exposed=Window]
interface HTMLInstallElement : HTMLElement {
  [HTMLConstructor] constructor();

  [CEReactions, ReflectURL] attribute USVString manifest;
  [CEReactions, ReflectURL] attribute USVString manifestId;
};

// Source: Web Install (https://wicg.github.io/install-element/)
HTMLInstallElement includes ActivationBlockersMixin;