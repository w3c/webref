// Source: WebRTC: Real-Time Communication in Browsers (https://www.w3.org/TR/webrtc/)
dictionary RTCRtpHeaderExtensionCapability {
  required DOMString uri;
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial dictionary RTCRtpHeaderExtensionCapability {
  required RTCRtpTransceiverDirection direction;
};