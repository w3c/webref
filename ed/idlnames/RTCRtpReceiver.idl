// Source: WebRTC: Real-Time Communication in Browsers (https://www.w3.org/TR/webrtc/)
[Exposed=Window]
interface RTCRtpReceiver {
  readonly attribute MediaStreamTrack track;
  readonly attribute RTCDtlsTransport? transport;
  static RTCRtpCapabilities? getCapabilities(DOMString kind);
  RTCRtpReceiveParameters getParameters();
  sequence<RTCRtpContributingSource> getContributingSources();
  sequence<RTCRtpSynchronizationSource> getSynchronizationSources();
  Promise<RTCStatsReport> getStats();
  attribute DOMHighResTimeStamp? jitterBufferTarget;
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial interface RTCRtpReceiver {
  attribute EventHandler onssrcchange;
  attribute EventHandler oncsrcchange;
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial interface RTCRtpReceiver {
  static undefined disableHardwareDecoding();
};

// Source: WebRTC Encoded Transform (https://www.w3.org/TR/webrtc-encoded-transform/)
partial interface RTCRtpReceiver {
    attribute RTCRtpReceiverTransform? transform;
};