// Source: Web Bluetooth (https://bluetooth.spec.whatwg.org/)
[Exposed=Window, SecureContext]
interface Bluetooth : EventTarget {
  Promise<boolean> getAvailability();
  attribute EventHandler onavailabilitychanged;
  [SameObject]
  readonly attribute BluetoothDevice? referringDevice;
  Promise<sequence<BluetoothDevice>> getDevices();
  Promise<BluetoothDevice> requestDevice(optional RequestDeviceOptions options = {});
};

// Source: Web Bluetooth (https://bluetooth.spec.whatwg.org/)
Bluetooth includes BluetoothDeviceEventHandlers;

// Source: Web Bluetooth (https://bluetooth.spec.whatwg.org/)
Bluetooth includes CharacteristicEventHandlers;

// Source: Web Bluetooth (https://bluetooth.spec.whatwg.org/)
Bluetooth includes ServiceEventHandlers;

// Source: Web Bluetooth Scanning (https://bluetooth.spec.whatwg.org/scanning.html)
partial interface Bluetooth {
  [SecureContext]
  Promise<BluetoothLEScan> requestLEScan(optional BluetoothLEScanOptions options = {});
};