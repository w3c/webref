// Source: WebRTC: Real-Time Communication in Browsers (https://www.w3.org/TR/webrtc/)
dictionary RTCConfiguration {
  sequence<RTCIceServer> iceServers = [];
  RTCIceTransportPolicy iceTransportPolicy = "all";
  RTCBundlePolicy bundlePolicy = "balanced";
  RTCRtcpMuxPolicy rtcpMuxPolicy = "require";
  sequence<RTCCertificate> certificates = [];
  [EnforceRange] octet iceCandidatePoolSize = 0;
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial dictionary RTCConfiguration {
  RTCRtpHeaderEncryptionPolicy rtpHeaderEncryptionPolicy = "negotiate";
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial dictionary RTCConfiguration {
    boolean alwaysNegotiateDataChannels = false;
};

// Source: WebRTC Extensions (https://w3c.github.io/webrtc-extensions/)
partial dictionary RTCConfiguration {
  RTCConfigurationTargetLatency targetLatency = "lowest";
};

// Source: Identity for WebRTC 1.0 (https://www.w3.org/TR/webrtc-identity/)
partial dictionary RTCConfiguration {
  DOMString peerIdentity;
};